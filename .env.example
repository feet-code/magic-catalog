# The same shared deployment variables used by seo-test.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_SUBDOMAIN=
POSTHOG_PROJECT_ID=
POSTHOG_PROJECT_API_KEY=
POSTHOG_INGEST_HOST=https://us.i.posthog.com
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GOOGLE_SEARCH_CONSOLE_OWNER_EMAIL=

# Optional when a newly deployed verification tag takes longer to propagate.
GOOGLE_VERIFICATION_TIMEOUT_SECONDS=300
GOOGLE_VERIFICATION_POLL_SECONDS=5
