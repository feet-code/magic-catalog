{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "magic-catalog",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magic-catalog",
      "database_id": "828e87d1-e0d0-4eaf-a9e5-ffc6d0bdc8ae",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "PRODUCT_INDEX",
      "index_name": "magic-catalog-products"
    }
  ],
  "vars": {
    "SITE_URL": "https://magic-catalog.cloudwebsites.workers.dev",
    "GEMINI_MODELS": "gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash"
  },
  "observability": {
    "enabled": true
  }
}
